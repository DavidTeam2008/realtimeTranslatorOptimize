    "platform.summary.deviceNotEligible" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone cannot use Apple Intelligence. Export the transcript and summarize it in another app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone では Apple Intelligence を使えません。文字起こしを書き出して、ほかのアプリで要約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서는 Apple Intelligence를 사용할 수 없습니다. 기록을 내보낸 뒤 다른 앱에서 요약하세요."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone เครื่องนี้ใช้ Apple Intelligence ไม่ได้ ส่งออกข้อความแล้วสรุปในแอปอื่นได้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone này không dùng được Apple Intelligence. Hãy xuất bản ghi và tóm tắt bằng ứng dụng khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 不能使用 Apple 智能。可以把文字稿导出，用元宝等工具总结。"
          }
        }
      }
    },
